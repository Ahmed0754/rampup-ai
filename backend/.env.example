GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Settings -> API -> JWT Settings -> "JWT Secret". Lets the backend verify
# user session tokens locally instead of calling Supabase Auth on every
# request. Optional - falls back to the network check if unset.
SUPABASE_JWT_SECRET=
# Comma-separated list of frontend origins allowed to call this API.
# Defaults to http://localhost:5173,http://localhost:5174 if unset. Add your
# deployed frontend's URL (e.g. https://your-app.vercel.app) in production.
CORS_ORIGINS=

# Only needed for the weekly nudge script (scripts/weekly_nudge.py) - not
# used by the API itself. Free key from https://resend.com/api-keys.
RESEND_API_KEY=
# Optional: link included in the nudge email. e.g. https://your-app.vercel.app
FRONTEND_URL=
# Optional: defaults to onboarding@resend.dev (no domain setup needed, but
# more likely to land in spam). Use a verified sending domain if you have one.
REMINDER_FROM_EMAIL=
